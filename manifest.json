{
  "manifest_version": 3,
  "name": "Beautiful YT Type Local Player",
  "version": "1.4.2",
  "description": "Красивый YouTube-подобный плеер для локальных видео и аудио с запоминанием позиции",
  "permissions": ["storage"],
  "host_permissions": ["file://*/*"],
  "content_scripts": [
    {
      "matches": ["file://*/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Beautiful YT Type Local Player",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
